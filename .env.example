# Every setting hydra-server reads, with its built-in default.
# Copy to .env and change what you need — anything left commented keeps the
# default shown, so an empty file is a working configuration except for
# HYDRA_ADMIN_PASSWORD.

# --------------------------------------------------------------- essentials

HYDRA_SERVER_BIND=0.0.0.0:8788

# URL your friends' launchers can reach this server on (reverse proxy domain).
# Upload and download URLs are built from it, so it must be the public one.
HYDRA_SERVER_PUBLIC_URL=http://localhost:8788

# SQLite database, stored save files and database backups all live here.
# Under Docker the image sets this to /data (the mounted volume) and the port
# is published by compose, so those two lines are ignored there.
HYDRA_SERVER_DATA_DIR=./data

# Required — the /admin panel stays disabled while this is empty.
HYDRA_ADMIN_PASSWORD=

# Signs storage URLs and admin/portal sessions. Generated on first start and
# kept in <data dir>/.secret; set it here to share one across replicas, or to
# keep sessions valid when the data dir is wiped.
#HYDRA_SERVER_SECRET=

# ------------------------------------------------------------------ accounts

# Official API used to validate launcher access tokens. If validation fails
# with your launcher build, set this to the API it was built against
# (MAIN_VITE_API_URL).
HYDRA_OFFICIAL_API_URL=https://hydra-api-us-east-1.losbroxas.org

# Comma-separated official user ids or usernames; empty = anyone with a Hydra
# login. Also editable live from the admin panel.
HYDRA_ALLOWED_USERS=

# 0 = unlimited; e.g. 10737418240 = 10 GiB per user. Editable in the panel.
HYDRA_MAX_BYTES_PER_USER=10737418240

# Max legacy save backups kept per game per user. Editable in the panel.
HYDRA_BACKUPS_PER_GAME_LIMIT=10

# -------------------------------------------------------------------- portal

# The players' own view of their saves at /portal.
#HYDRA_PORTAL_ENABLED=true

# Where the portal sends a password sign-in on the official API. The official
# API has no such endpoint — it signs people in on its website — so there the
# portal falls back to a refresh token or an admin-minted link. Point this at
# your own API if it does accept passwords.
#HYDRA_OFFICIAL_LOGIN_PATH=/auth/login

# Where a launcher refresh token is traded for an access token. This is the
# route that works against the official API.
#HYDRA_OFFICIAL_REFRESH_PATH=/auth/refresh

# --------------------------------------------------------- sign-in protection

# Failed sign-ins from one address, within fifteen minutes, before it is
# locked out — and for how long.
#HYDRA_LOGIN_MAX_ATTEMPTS=8
#HYDRA_LOGIN_LOCKOUT_MINUTES=15

# Take the client address from forwarding headers instead of the socket. Only
# enable when a proxy is the only way in: these headers are forgeable by
# anything that can reach the server directly, and the lockout keys on them.
#HYDRA_TRUST_PROXY_HEADERS=false

# For the X-Forwarded-For fallback, how many proxies append to it after the
# entry you want — 0 for a single reverse proxy, 1 with Cloudflare in front of
# it. (Cloudflare's own CF-Connecting-IP is preferred automatically.)
#HYDRA_TRUSTED_PROXY_HOPS=0

# Read the address from this header only, when your proxy uses another one.
#HYDRA_CLIENT_IP_HEADER=

# ------------------------------------------------------------ history, alerts

# Days of event history kept. Older rows are pruned daily.
#HYDRA_EVENT_RETENTION_DAYS=90

# Quiet minutes after which a launcher counts as away, so its next call is
# logged as coming online. 0 switches those events off.
#HYDRA_PRESENCE_IDLE_MINUTES=15

# Prometheus metrics at /metrics: counts and totals only, nothing personal.
#HYDRA_METRICS_ENABLED=true
#HYDRA_METRICS_TOKEN=

# ------------------------------------------------------------------- backups

# Hours between automatic database backups (0 disables them), and how many are
# kept before the oldest is pruned. Backups land in <data dir>/backups.
#HYDRA_BACKUP_INTERVAL_HOURS=24
#HYDRA_BACKUP_KEEP=7
